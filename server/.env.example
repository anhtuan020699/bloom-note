# Shared Postgres trên homelab (~/apps/shared-db)
# User: postgres | Pass: secretpassword | DB: shared | Port: 5432

# Dev từ máy khác qua Tailscale (homelap = 100.87.194.8):
DATABASE_URL=postgres://postgres:secretpassword@100.87.194.8:5432/shared

# API chạy trực tiếp trên máy homelab:
# DATABASE_URL=postgres://postgres:secretpassword@127.0.0.1:5432/shared

# API chạy Docker, join network apps_shared:
# DATABASE_URL=postgres://postgres:secretpassword@postgres:5432/shared
